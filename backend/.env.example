# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored and must NEVER be committed.

# Port the API server listens on.
# If you change this, also change the proxy target in frontend/vite.config.js.
PORT=5000

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=JL_Jewellers_ERP

# --- Auth ---
# Use a long random string. Never reuse the value from any old commit.
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRY=1d
